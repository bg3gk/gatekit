<!-- Weave's worked example: Weave.Demo(true). Copy it with Weave.Eject("demo.weave") and
     edit the copy while the game runs. -->
<template>
  <window id="demo" title="Weave · demo ({{ items.length }} items)" width="620" height="560" x="60" y="120">
    <menubar>
      <menu label="Window">
        <item label="Settings" @click="settings()"/>
      </menu>
    </menubar>
    <tabs>
      <tab id="tab-reactive" label="Reactive">
        <text id="greeting" :class="{ loud = volume >= 80 }">Hello, {{ name }}! Volume {{ volume }}.</text>
        <input id="name" #model="name" hint="a name" width="240"/>
        <slider id="volume" #model="volume" int min="0" max="100" label="Volume" width="240"/>
        <text id="loud" #if="volume >= 80" class="text-warn">That is loud.</text>
        <text id="quiet" #else-if="volume == 0" class="text-muted">Silence.</text>
        <combo id="level" :options="levels" #model="level" label="Level" width="240"/>
        <text id="facts" class="muted">Level is {{ level }}; the name has {{ name.length }} letters; twice the volume is {{ double }}.</text>
        <text id="wrong" #show="level == 'Error'" class="error">Something is wrong.</text>
        <separator/>
        <button id="reset" @click="reset()" :disabled="volume == 40 &amp;&amp; name == 'Tav'">Reset</button>
      </tab>

      <tab id="tab-lists" label="Lists">
        <row>
          <button id="add" class="primary" @click="add()">Add an item</button>
          <button id="remove" @click="table.remove(items)" :disabled="items.length == 0">Remove the last</button>
          <button id="clear" @click="items = {}">Clear</button>
          <text id="count" class="muted">{{ items.length }} {{ items.length == 1 ? "item" : "items" }}</text>
        </row>
        <child id="list" height="-1" border>
          <bullet #for="item, i in items" :key="item.id">{{ i }}. {{ item.label }}</bullet>
          <text #if="items.length == 0" class="text-faint">Nothing here yet.</text>
        </child>
      </tab>

      <tab id="tab-layout" label="Layout">
        <text id="layout-hint" class="text-sm text-muted wrap">Resize this window. Flex and grid as on the web; the cards go from one column to two at 640 and three at 768 (sm: and md:).</text>
        <group id="toolbar" class="flex justify-between items-center">
          <text class="text-lg text-accent">A mod's page</text>
          <group id="nav" class="flex gap-2">
            <button #for="page in pages" :key="page" :class="{ primary = page == current }" @click="current = page">{{ page }}</button>
          </group>
        </group>
        <group id="search" class="flex items-center gap-2">
          <text>Search</text>
          <input id="query" class="grow" #model="query" hint="type to filter the cards"/>
          <button id="go" @click="query = ''">Clear</button>
        </group>
        <group id="cards" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          <demo-card #for="card in shown" :key="card.title" :title="card.title" :note="card.note"/>
        </group>
        <group id="side" class="flex-col items-center">
          <text id="side-note" class="text-sm">{{ shown.length }} of {{ cards.length }} cards on the page "{{ current }}"</text>
          <text class="text-warn sm:hidden">shown below 640 only (sm:hidden)</text>
        </group>
        <group id="box" class="flex items-center gap-x-2 px-4 py-3 rounded-lg">
          <text class="text-sm">a box: padding, margins, w-1/4, aspect-[3/1]</text>
          <button class="w-1/4 ml-auto">a quarter</button>
          <button class="w-[90] aspect-[3/1]">3 / 1</button>
        </group>
      </tab>

      <tab id="tab-graphics" label="Graphics">
        <text class="text-sm text-muted wrap">Gradients, shadows, outlines, backgrounds behind text, pictures, fonts and the canvas: everything here is a style or an element of the template.</text>
        <spacing/>
        <group id="banner">
          <text class="text-xl text-strong">A gradient behind a group</text>
          <text class="text-soft">rounded, outlined, with a shadow</text>
        </group>
        <spacing/>
        <row class="gap-3">
          <button id="glow" class="glow p-3">Gradient button</button>
          <text id="badge">text with a background</text>
          <button id="locked" disabled="true" tip="disabled">Disabled</button>
        </row>
        <group id="pictures" class="flex items-center gap-4">
          <image id="knot" src="Mods/Gwynerva_Weave/ScriptExtender/Lua/ui/weave.png" width="48"/>
          <text id="tiled">a picture from a file, tiled behind text</text>
          <button id="fade" class="transition" :class="{ lit = lit }" @click="lit = !lit">transition: click me</button>
        </group>
        <text id="display">A font of one's own, at any size</text>
        <text id="centered" class="text-center text-accent">text-center</text>
        <text id="righted" class="text-right text-muted">text-right</text>
        <canvas id="chart" width="560" height="150" :draw="chart"/>
        <slider id="wave" #model="wave" int min="1" max="12" label="the chart follows this" width="240"/>
      </tab>

      <tab id="tab-classes" label="Classes">
        <text class="text-xl text-accent">Utility classes</text>
        <text class="text-sm text-muted wrap">Tailwind 4's vocabulary, worked out from the names: any number, any theme colour, variants in front.</text>
        <child class="card flex-col gap-2" height="170">
          <group class="flex gap-3">
            <text>text-normal</text>
            <text class="text-soft">text-soft</text>
            <text class="text-muted">text-muted</text>
            <text class="text-accent">text-accent</text>
            <text class="text-ok">text-ok</text>
            <text class="text-warn">text-warn</text>
            <text class="text-error">text-error</text>
          </group>
          <group class="flex gap-3">
            <text class="text-red-400">red-400</text>
            <text class="text-amber-300">amber-300</text>
            <text class="text-emerald-400">emerald-400</text>
            <text class="text-sky-400">sky-400</text>
            <text class="text-violet-300">violet-300</text>
            <text class="text-sky-400/50">sky-400/50</text>
          </group>
          <group class="flex gap-3 items-end">
            <text class="text-xs">text-xs</text>
            <text class="text-sm">text-sm</text>
            <text class="text-base">text-base</text>
            <text class="text-lg">text-lg</text>
            <text class="text-xl">text-xl</text>
            <text class="text-2xl">text-2xl</text>
          </group>
        </child>
        <group class="flex flex-wrap gap-3 items-center">
          <button class="px-6 py-2 rounded-lg bg-linear-to-r from-amber-600 to-rose-700 text-white shadow-lg">gradient, shadow-lg</button>
          <button class="px-4 py-2 rounded-full bg-emerald-700 hover:bg-emerald-500 text-white">hover:bg-emerald-500</button>
          <button class="px-4 py-2 rounded-none bg-transparent outline outline-accent">outline</button>
          <text class="px-2 bg-sky-500/25 rounded-md bg-pad-1">bg-sky-500/25</text>
          <text class="bg-[#402060] rounded-sm bg-pad-1 text-[#e0c0ff]">bg-[#402060]</text>
        </group>
        <group class="grid grid-cols-auto-[150] gap-2">
          <button class="bg-slate-700">grid-cols-auto-[150]</button>
          <button class="bg-slate-700">as many</button>
          <button class="bg-slate-700">columns</button>
          <button class="bg-slate-700">as fit</button>
          <button class="bg-slate-700 col-span-2">col-span-2</button>
        </group>
        <text class="text-sm text-muted max-md:text-warn">max-md:text-warn - yellow below 768</text>
      </tab>

      <tab id="tab-elements" label="Elements">
        <heading>Texts</heading>
        <text>text</text>
        <bullet>bullet</bullet>
        <link>link</link>
        <heading>Inputs</heading>
        <checkbox label="checkbox" checked="true"/>
        <radio label="radio"/>
        <drag label="drag (speed 0.05)" min="0" max="10" value="3" speed="0.05" width="200"/>
        <number label="number (step 5)" int value="7" step="5" width="200"/>
        <progress :value="volume / 100" overlay="the volume" width="200"/>
        <heading>Containers</heading>
        <header id="header" label="header" :open="headerOpen" @expand="headerOpen = true" @collapse="headerOpen = false">
          <text>inside a header</text>
        </header>
        <tree label="tree" open>
          <selectable id="pick" @dblclick="picks = picks + 1">selectable: double-clicked {{ picks }} times</selectable>
        </tree>
        <table columns="3" headers="Tag|Widget|Value" flags="Borders RowBg">
          <tr><td><text>checkbox</text></td><td><text>AddCheckbox</text></td><td><text>true / false</text></td></tr>
          <tr><td><text>input</text></td><td><text>AddInputText</text></td><td><text>text</text></td></tr>
          <tr><td><text>combo</text></td><td><text>AddCombo</text></td><td><text>the chosen option</text></td></tr>
        </table>
      </tab>
    </tabs>
  </window>
</template>

<script>
-- A value assigned here is reactive state; a function is something the template can call.
name = "Tav"
volume = 40
level = "Info"
levels = { "Debug", "Info", "Warning", "Error" }
items = {}
nextId = 1
wave = 4
lit = false
headerOpen = true
picks = 0

pages = { "Home", "Items", "About" }
current = "Home"
query = ""
cards = {
    { page = "Home", title = "Welcome", note = "a component: demo-card.weave" },
    { page = "Home", title = "News", note = "built by #for from a list" },
    { page = "Home", title = "Guide", note = "placed by the grid" },
    { page = "Items", title = "Sword", note = "one column below 640" },
    { page = "Items", title = "Shield", note = "two from 640, three from 768" },
    { page = "About", title = "Credits", note = "the pages are plain state" },
}

computed("double", function() return volume * 2 end)

-- The cards of the current page that match the search.
computed("shown", function()
    local out, wanted = {}, query:lower()
    for _, card in ipairs(cards) do
        if card.page == current and (wanted == "" or card.title:lower():find(wanted, 1, true)) then
            out[#out + 1] = card
        end
    end
    return out
end)

-- A drawing worked out from state: move the slider and it is drawn anew.
computed("chart", function()
    local points = {}
    for i = 0, 22 do points[#points + 1] = { 20 + i * 24, 80 - 45 * math.sin(i / (wave / 1.5)) * math.cos(i / 7) } end
    return {
        { "gradient", 0, 0, 560, 150, "var(--bg-alt)", "var(--panel)", 180, 8 },
        { "rect", 0, 0, 560, 150, "var(--border)", 8, 1 },
        { "line", 20, 130, 548, 130, "alpha(var(--text), 0.35)", 1 },
        { "line", 20, 80, 548, 80, "alpha(var(--text), 0.12)", 1 },
        { "polyline", points, "var(--accent)", false, 2 },
        { "disc", points[6][1], points[6][2], 5, "var(--accent-strong)" },
        { "text", 14, 8, "var(--muted)", "canvas :draw - a drawing computed from state" },
    }
end)

function add()
    items[#items + 1] = { id = nextId, label = "item " .. nextId }
    nextId = nextId + 1
end

function reset()
    name, volume, level = "Tav", 40, "Info"
end

function settings() Weave.Settings.Open(true) end
</script>

<style>
#greeting        { color: var(--accent-strong); font: +1; }
#greeting.loud   { color: var(--log-error); font: +2; }
#list            { padding: 8 10; background: var(--bg-alt); }
#list bullet     { color: var(--text); }
tab > heading    { color: var(--accent); }
progress         { background: var(--panel); PlotHistogram: var(--accent); }

/* Sizes are checked against the window (@media) or a container (@container). */
#side                    { container-type: size; }
@container (max-width: 260) { #side-note { color: var(--log-warning); } }
@media (max-width: 639)  { #layout-hint { color: var(--log-warning); } }

/* Rules nest; the first card of the list is told apart, whatever the filter leaves in it. */
#cards {
  child:first-child { border-color: var(--accent-strong); }
}
#box {
  background: var(--bg-alt); outline: 1 var(--border);
  button:not(:last-child) { color: var(--accent-strong); }
}

/* Drawn behind the elements. */
#banner          { background: linear-gradient(to right, mix(var(--accent), #000000, 0.6), var(--bg-alt));
                   rounding: 8; background-padding: 8 10; outline: 1 var(--border);
                   box-shadow: 3 4 12 alpha(#000000, 0.6); margin: 10 10; }
button.glow      { background: linear-gradient(to bottom, var(--accent-strong), mix(var(--accent), #000000, 0.45));
                   color: #1a1208; rounding: 6; outline: 1 var(--accent-strong); }
button.glow:hover { background: alpha(#ffffff, 0.18); }
#badge           { background: alpha(var(--accent), 0.25); rounding: 4; background-padding: 2 5; }

/* Pictures are files of the mod (png, jpg, tga, bmp), textures of the game or atlas icons. */
#tiled           { background-image: url(Mods/Gwynerva_Weave/ScriptExtender/Lua/ui/weave.png); background-mode: tile; background-tint: alpha(#ffffff, 0.3);
                   background-padding: 6 8; rounding: 4; }
#fade            { background: var(--panel); transition: 0.4; }
#fade.lit        { background: var(--log-error); color: #ffffff; rounding: 12; }

/* A font of one's own: a .ttf in the game's data (so in a mod's pak), then any size. */
@font-face { font-family: Quadraat; src: url(Public/Game/GUI/Assets/Fonts/QuadraatOffcPro/QuadraatOffcPro.ttf); }
#display         { font-family: Quadraat; font-size: 56; color: var(--accent-strong); }
</style>
