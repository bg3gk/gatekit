<!-- A component: its own template, properties (title, note) and a slot for what the caller puts inside. -->
<template>
  <child class="card" height="84">
    <text class="text-strong">{{ title }}</text>
    <text class="text-sm text-muted">{{ note }}</text>
    <slot/>
  </child>
</template>

<style scoped>
child { background: var(--bg-alt); rounding: 6; padding: 8 10; border: 1; border-color: var(--border); }
</style>
