    "trace_change": {"family": "trace", "class": "observation", "knows": "omniscient", "payload": {"step": "the step it was recorded in", "entity": "the entity handle", "uuid": "its uuid, when it has one", "component": "the component's engine name", "flags": "what happened to it: Create, Destroy, Replicate, OneFrame, ReplicatedComponent, Modify", "count": "changes logged", "frame": "ECS frame of the first change", "flush": "command-buffer flush of the first change", "lastFrame": "of the latest change", "lastFlush": "", "events": "the changes, oldest first: { flags, frame, flush, order }", "droppedEvents": "events past the tracer's limit", "entityFlags": "what happened to the entity: Create, Destroy, Immediate, Dead, Ignore"}},
    "trace_system": {"family": "trace", "class": "observation", "knows": "omniscient", "payload": {"step": "", "entity": "", "uuid": "", "component": "the component changed", "system": "the system whose update changed it (engine name)", "thread": "", "frame": "", "flush": ""}},
    "trace_step": {"family": "trace", "class": "observation", "knows": "omniscient", "payload": {"step": "the step that ended", "entities": "entities changed", "changes": "entity-component logs", "written": "of them written as rows", "systems": "system changes", "systemsWritten": "of them written as rows", "droppedSystems": "system changes past the tracer's limit", "frame": "", "flush": ""}},
    "trace_end": {"family": "trace", "class": "observation", "knows": "omniscient", "payload": {"frame": "", "flush": ""}},
    "memory_watch": {"family": "memory", "class": "observation", "knows": "omniscient", "payload": {"did": "rearmed or closed", "slot": "the watch's slot before", "armed": "its slot after, when rearmed", "was": "the address it watched", "now": "the place's address now, nil when its component is gone", "why": "why it was closed", "entity": "", "component": "the component's engine name", "field": "the field, for a field's watch", "offset": "the offset into the component, for an address given its owner", "watch": "the watch's own number, kept across re-arming", "heldHits": "the hits of moved slots held as not the field's"}}
  }
}
