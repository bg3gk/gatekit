    "rest_ended": {"family": "attention", "class": "observation", "knows": "player", "attention": "end", "payload": {"opened": "seq of the row that opened it", "window": "registry name"}},
    "tutorial": {"family": "attention", "class": "observation", "knows": "player", "attention": "begin", "ends": "tutorial_ended", "payload": {"window": "registry name", "widget": "the widget", "choices": "what can be chosen"}},
    "tutorial_ended": {"family": "attention", "class": "observation", "knows": "player", "attention": "end", "payload": {"opened": "seq of the row that opened it", "window": "registry name"}},
