{
  "schema": "events/kinds/1",
  "about": "The one registry of the event log: every family and every kind a row may have. The mod reads it at start (Shared/EventLog.lua) and refuses a row of any other kind; the host reads the same file (embedded in GateKit.Bridge) to check, merge and filter rows. Adding a family is an entry here plus the code that writes its rows. docs/contracts/bridge-protocol.md, \"The event log\".",
  "families": {
    "state": {"always": true, "about": "the game's state machine"},
    "attention": {"always": true, "about": "what waits for the player, and what changed (GK.Attention)"},
    "game": {"always": true, "about": "the game log: what a player notices (GK.GameLog)"},
    "scope": {"always": true, "about": "the stage scope and what is staged in it (GK.Stage, GK.Fixture)"},
    "log": {"always": true, "about": "the log about itself: families switched, rows dropped"},
    "note": {"always": true, "about": "a caller's own marks (GK.Note)"},
    "osiris": {"about": "the Osiris events GK.Watch listens to (a level load alone writes hundreds of Equipped and TemplateAddedTo): on for a check"},
    "status": {"about": "every status applied and removed, on any object (Osiris StatusApplied / StatusRemoved)"},
    "entity": {"about": "every character and item created or destroyed (ServerCharacter, ServerItem)"},
    "surface": {"about": "every surface created or destroyed (ServerSurface)"},
    "component": {"about": "every component of the named types created or destroyed (GK.EventLog.On's options.components)"},
    "dice": {"about": "every roll the game's roll manager throws, with the code that asked for it (GK.RollLog; needs the Script Extender build with roll events): on for a check - a fight throws many"},
    "trace": {"about": "the entity tracer's record, cut into steps (GK.Trace): on while a trace runs"},
    "memory": {"always": true, "about": "the memory instrument's watches that moved with their component (GK.Memory)"}
  },
  "kinds": {
    "game_state": {"family": "state", "class": "observation", "knows": "player", "payload": {"from": "the state left", "to": "the state entered"}},
    "osiris": {"family": "osiris", "class": "observation", "knows": "omniscient", "payload": {"event": "the Osiris event", "args": "its arguments"}},
    "note": {"family": "note", "class": "observation", "knows": "omniscient", "payload": {"note": "the caller's name for it", "data": "what the caller gave"}},
    "step": {"family": "note", "class": "observation", "knows": "omniscient", "payload": {"name": "the test's name for the step", "class": "fair, cheat or observation: what the step may call", "case": "the case it runs in, in a test with cases"}},
    "step_ended": {"family": "note", "class": "observation", "knows": "omniscient", "payload": {"name": "the step", "class": "its class", "outcome": "pass, fail or unmet", "ms": "how long it took on the host", "error": "why it failed", "case": "the case it ran in"}},

    "dialogue": {"family": "attention", "class": "observation", "knows": "player", "attention": "begin", "ends": "dialogue_ended", "payload": {"window": "registry name", "widget": "the widget", "choices": "what can be chosen"}},
    "dialogue_ended": {"family": "attention", "class": "observation", "knows": "player", "attention": "end", "payload": {"opened": "seq of the row that opened it", "window": "registry name"}},
    "dialogue_choice": {"family": "attention", "class": "observation", "knows": "player", "attention": "begin", "ends": "dialogue_phase_ended", "payload": {"window": "dialogue", "set": "the set of answers", "speaker": "who speaks", "text": "the line", "answers": "the answers shown", "canTrade": "a trade is offered", "ready": "answers can be chosen"}},
    "dialogue_continue": {"family": "attention", "class": "observation", "knows": "player", "attention": "begin", "ends": "dialogue_phase_ended", "payload": {"window": "dialogue", "set": "the set of answers", "speaker": "who speaks", "text": "the line", "answers": "the answers shown", "canTrade": "a trade is offered", "ready": "a click goes on"}},
    "dialogue_line": {"family": "attention", "class": "observation", "knows": "player", "attention": "hold", "ends": "dialogue_phase_ended", "payload": {"window": "dialogue", "set": "the set of answers", "speaker": "who speaks", "text": "the line", "ready": "false: nothing to answer yet"}},
    "dialogue_phase_ended": {"family": "attention", "class": "observation", "knows": "player", "attention": "release", "payload": {"opened": "seq of the row that opened it", "window": "dialogue"}},
    "roll": {"family": "attention", "class": "observation", "knows": "player", "attention": "begin", "ends": "roll_ended", "payload": {"window": "registry name", "widget": "the widget", "choices": "what can be chosen", "who": "the roller's uuid (the window's SourceObject)", "check": "the check as the window names it, in the game's language", "skill": "the skill or ability, in the game's language", "pure": "true for a roll of an ability alone", "context": "the game's RollContext (DialogCheck ...)", "dc": "the difficulty", "target": "the natural die that passes (the difficulty less the bonus)", "advantage": "the game's RollAdvantageType when not None", "modifiers": "the listed modifiers: { name, value, off? }", "boosts": "the bonuses offered (inspiration, spells): { name, value, off? }", "bonus": "the sum of the modifiers, or { low, high }", "inspiration": "the party's inspiration points the window shows"}},
    "roll_ended": {"family": "attention", "class": "observation", "knows": "player", "attention": "end", "payload": {"opened": "seq of the row that opened it", "window": "registry name", "who": "the roller's uuid", "check": "the check", "skill": "the skill or ability", "pure": "true for a roll of an ability alone", "dc": "the difficulty", "advantage": "advantage or disadvantage", "modifiers": "the listed modifiers", "bonus": "the sum of the modifiers, or { low, high }", "added": "the bonuses added in the window: { name, spell, dice, value, by } (value: its die once thrown)", "dice": "the natural dice shown: one, or two with advantage or disadvantage", "natural": "the die that counts (the window's FinalResult)", "total": "the die and the listed bonus (none when the bonus is a range)", "success": "whether the check passed", "critical": "success on a natural 20, failure on a natural 1", "state": "the window's last RollState seen", "inspiration": "the inspiration points left", "rerolls": "times thrown again with inspiration"}},
    "reaction": {"family": "attention", "class": "observation", "knows": "player", "attention": "begin", "ends": "reaction_ended", "payload": {"window": "registry name", "widget": "the widget", "choices": "what can be chosen", "hooked": "opened by the engine's component, closed by it"}},
    "reaction_ended": {"family": "attention", "class": "observation", "knows": "player", "attention": "end", "payload": {"opened": "seq of the row that opened it", "window": "registry name"}},
    "box": {"family": "attention", "class": "observation", "knows": "player", "attention": "begin", "ends": "box_ended", "payload": {"window": "registry name", "widget": "the widget", "choices": "what can be chosen"}},
    "box_ended": {"family": "attention", "class": "observation", "knows": "player", "attention": "end", "payload": {"opened": "seq of the row that opened it", "window": "registry name"}},
    "gameover": {"family": "attention", "class": "observation", "knows": "player", "attention": "begin", "ends": "gameover_ended", "payload": {"window": "box", "widget": "the widget", "choices": "what can be chosen", "gameOver": "true"}},
    "gameover_ended": {"family": "attention", "class": "observation", "knows": "player", "attention": "end", "payload": {"opened": "seq of the row that opened it", "window": "registry name"}},
    "reward": {"family": "attention", "class": "observation", "knows": "player", "attention": "begin", "ends": "reward_ended", "payload": {"window": "registry name", "widget": "the widget", "choices": "what can be chosen"}},
    "reward_ended": {"family": "attention", "class": "observation", "knows": "player", "attention": "end", "payload": {"opened": "seq of the row that opened it", "window": "registry name"}},
