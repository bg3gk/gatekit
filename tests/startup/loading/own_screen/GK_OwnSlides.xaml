<ls:UIWidget x:Name="GK_OWN_Slides"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ls="clr-namespace:ls;assembly=Code"
             ls:UIWidget.ContextName="LoadingScreen">
    <!-- A mod's own slideshow on its own loading screen: the game's slideshow control
         (ls:LSImageSequence, the one its loading screen uses per act), with the mod's own list of
         images in its Resources, shuffled and changed on its own clock (here every 4 s). The images
         are named, not shipped: three single pictures of the game's own loading screens (the
         tutorial's, the key art, the first start's - art 13, 14, 15), a set no act of the game shows,
         so the set is plainly the mod's. A mod's own image needs a DDS listed in its GUI/metadata.lsf.
         The slideshow is made only for an Act 1 load: a template set by a DataTrigger, as the game's
         own screen picks its act's set - a slideshow made and merely hidden would still start and
         run its clock on every load. A page of its own, so a slideshow the game refused would leave
         the wallpaper page standing. -->
    <ls:UIWidget.Resources>
        <ControlTemplate x:Key="GK_OWN_Set">
            <Border BorderBrush="#D99A00" BorderThickness="6" Background="#0B1026">
                <ls:LSImageSequence x:Name="GK_OWN_Sequence" Width="1280" Height="720" Opacity="0"
                                    ImageFadeInDuration="0:0:0.4" ImageHoldDuration="0:0:4" ImageFadeOutDuration="0:0:0.4" Shuffle="True">
                    <ls:LSImageSequence.Resources>
                        <BitmapImage x:Key="gk13" UriSource="pack://application:,,,/Core;component/Assets/LoadingScreen/loadScreen_BGartwork_13.png"/>
                        <BitmapImage x:Key="gk14" UriSource="pack://application:,,,/Core;component/Assets/LoadingScreen/loadScreen_BGartwork_14.png"/>
                        <BitmapImage x:Key="gk15" UriSource="pack://application:,,,/Core;component/Assets/LoadingScreen/loadScreen_BGartwork_15.png"/>
                    </ls:LSImageSequence.Resources>
                </ls:LSImageSequence>
            </Border>
        </ControlTemplate>
    </ls:UIWidget.Resources>
    <Control x:Name="GK_OWN_SlidesPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Control.Style>
            <Style TargetType="Control">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LevelName}" Value="WLD_Main_A">
                        <Setter Property="Template" Value="{StaticResource GK_OWN_Set}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Control.Style>
    </Control>
</ls:UIWidget>
