<!-- A mod adds its own pages to the interface's Loading state: ModType="Extend" keeps the game's
     loading screen and puts these widgets beside it, made with it at every load. -->
<ls:StateMachine xmlns:ls="clr-namespace:ls;assembly=Code"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ls:StateMachine.States>
        <ls:State Name="Loading" ModType="Extend">
            <ls:State.Widgets>
                <ls:StateWidget Filename="GK_OwnLoading.xaml" Layer="Default" BlockedLoading="True"/>
                <ls:StateWidget Filename="GK_OwnSlides.xaml" Layer="Default" BlockedLoading="True"/>
            </ls:State.Widgets>
        </ls:State>
    </ls:StateMachine.States>
</ls:StateMachine>
