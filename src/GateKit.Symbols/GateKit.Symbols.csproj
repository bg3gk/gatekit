<Project Sdk="Microsoft.NET.Sdk">
  <!-- Symbol database of the engine's code (Toolkit DLLs and game executables) and the Ghidra pseudo-code pipeline. -->
  <PropertyGroup>
    <RootNamespace>GateKit.Symbols</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="System.CommandLine" Version="2.0.15" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GateKit.Release/GateKit.Release.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GateKit.Symbols.Tests" />
  </ItemGroup>
</Project>
