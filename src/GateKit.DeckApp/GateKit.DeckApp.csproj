<Project Sdk="Microsoft.NET.Sdk">
  <!-- `gatekit-deck`: the deck with no console at all. Same code as `gatekit deck`; the only
       difference is the subsystem, which is the whole point (see Program.cs). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>gatekit-deck</AssemblyName>
    <RootNamespace>GateKit.DeckApp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GateKit.Deck/GateKit.Deck.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.15" />
  </ItemGroup>
</Project>
