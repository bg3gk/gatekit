<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that differs between operating systems: where the game and its profile are,
       starting and finding game processes, links, window input and screenshots. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.27.13" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GateKit.Home/GateKit.Home.csproj" />
    <!-- The game's fingerprint is one of GateKit's own files (GameFingerprint). -->
    <ProjectReference Include="../GateKit.Json/GateKit.Json.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GateKit.UnitTests" />
  </ItemGroup>
</Project>
