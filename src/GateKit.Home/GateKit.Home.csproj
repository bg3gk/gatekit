<Project Sdk="Microsoft.NET.Sdk">
  <!-- Where everything GateKit keeps lives: the one home folder, the gatekit.json that names it,
       the variables that override single locations, and the one way a database is opened for
       reading. Depends on nothing else of GateKit, so every other project can use it. -->
  <PropertyGroup>
    <RootNamespace>GateKit.Home</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GateKit.UnitTests" />
  </ItemGroup>
</Project>
