+// The pixel shader for the current output encoding. The HDR10 one is compiled when first needed
+// and again when the paper white level changes (it is a constant in the shader).
+static ID3D11PixelShader* ImGui_ImplDX11_GetPixelShader()
+{
+    ImGui_ImplDX11_Data* bd = ImGui_ImplDX11_GetBackendData();
+    if (!bd->HDR10Output)
+        return bd->pPixelShader;
+
+    if (bd->pPixelShaderHDR10 != nullptr && bd->PixelShaderHDR10PaperWhite == bd->HDR10PaperWhite)
+        return bd->pPixelShaderHDR10;
+
+    if (bd->pPixelShaderHDR10) { bd->pPixelShaderHDR10->Release(); bd->pPixelShaderHDR10 = nullptr; }
+
+    static const char* pixelShaderFormat =
+        "struct PS_INPUT\
+        {\
+        float4 pos : SV_POSITION;\
+        float4 col : COLOR0;\
+        float2 uv  : TEXCOORD0;\
+        };\
+        sampler sampler0;\
+        Texture2D texture0;\
+        \
+        static const float3x3 Rec709ToRec2020 = {\
+        0.6274040, 0.3292820, 0.0433136,\
+        0.0690970, 0.9195400, 0.0113612,\
+        0.0163916, 0.0880132, 0.8955950 };\
+        \
+        float4 main(PS_INPUT input) : SV_Target\
+        {\
+        float4 out_col = input.col * texture0.Sample(sampler0, input.uv);\
+        float3 lin = pow(abs(out_col.rgb), 2.2);\
+        float3 nits = mul(Rec709ToRec2020, lin) * %f;\
+        float3 y = pow(saturate(nits / 10000.0), 0.1593017578125);\
+        float3 pq = pow((0.8359375 + 18.8515625 * y) / (1.0 + 18.6875 * y), 78.84375);\
+        return float4(pq, out_col.a);\
+        }";
+
+    char pixelShader[2048];
+    snprintf(pixelShader, sizeof(pixelShader), pixelShaderFormat, bd->HDR10PaperWhite);
+
+    ID3DBlob* pixelShaderBlob;
+    if (FAILED(D3DCompile(pixelShader, strlen(pixelShader), nullptr, nullptr, nullptr, "main", "ps_4_0", 0, 0, &pixelShaderBlob, nullptr)))
+        return bd->pPixelShader;
+    if (bd->pd3dDevice->CreatePixelShader(pixelShaderBlob->GetBufferPointer(), pixelShaderBlob->GetBufferSize(), nullptr, &bd->pPixelShaderHDR10) != S_OK)
+        bd->pPixelShaderHDR10 = nullptr;
+    pixelShaderBlob->Release();
+
+    bd->PixelShaderHDR10PaperWhite = bd->HDR10PaperWhite;
+    return bd->pPixelShaderHDR10 ? bd->pPixelShaderHDR10 : bd->pPixelShader;
+}
