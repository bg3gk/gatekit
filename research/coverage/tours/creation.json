    "wait": 2.0,
    "fixed": true
   },
   {
    "ui": "return { pcall(GK.Command, \"PlayVoice\", nil, \"gui::DCCharacterCreation\") }",
    "wait": 2.0,
    "fixed": true
   },
   {
    "ui": "return { pcall(GK.Command, \"SelectNextAbilityBonus\", nil, \"gui::DCCharacterCreation\") }",
    "wait": 2.0,
    "fixed": true
