<Project>
  <!-- Settings shared by every project of the host side. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
    <Authors>Gwynerva and GateKit contributors</Authors>
    <Copyright>Copyright (c) 2026 Gwynerva and GateKit contributors</Copyright>
    <RepositoryUrl>https://github.com/bg3gk/gatekit</RepositoryUrl>
  </PropertyGroup>
</Project>
