{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record/layout/1",
  "title": "A layout of the coverage survey (research/coverage/layouts/<batch>/<component>.json)",
  "description": "One component or system as the coverage survey wrote it down: its size, its fields with their rungs and evidence, and what the survey recorded beside them. `gatekit registry import layouts` carries each into registry/types/, where `survey` keeps everything but the fields, the size, the summary and the concept.",
  "type": "object",
  "required": ["component", "fields"],
  "additionalProperties": false,
  "properties": {
    "component": {"type": "string", "minLength": 1, "description": "The engine's name of the type."},
    "kind": {"const": "system", "description": "Present only on a system's layout."},
    "ext_name": {"type": "string", "description": "The name Script Extender's Lua answers to."},
    "oneFrame": {"type": "boolean"},
    "size": {"type": "integer", "minimum": 0},
    "summary": {"type": "string"},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "base": {"type": "string"},
    "class_size": {"type": "integer"},
    "confidence": {"type": "string"},
    "creator": {"type": "string"},
    "evidence": {"type": "string"},
    "external_types": {"type": ["object", "array"]},
    "from": {"type": "string"},
    "functions_read": {"type": "integer"},
    "hold": {"type": "string"},
    "live": {"type": "string"},
    "live_reason": {"type": "string"},
    "minutes": {"type": "integer"},
    "names": {"type": "string"},
    "names_pass": {"type": "string"},
    "names_pass_2": {"type": "string"},
    "needs_windows": {"type": "string"},
    "object": {"type": "object", "additionalProperties": true},
    "one_byte": {"type": "string"},
    "one_byte_evidence": {"type": "string"},
    "one_byte_values": {"type": "object", "additionalProperties": true},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "raw_check": {"type": "string"},
    "reuses": {"type": "string"},
    "same_as": {"type": "string"},
    "se_pattern": {"type": "string"},
    "second_pass": {"type": "string"},
    "seen": {"type": "boolean"},
    "size_check": {"type": "string"},
    "status": {"enum": ["confirmed", "declared", "hypothesis"]},
    "status_reason": {"type": "string"},
    "storage_size": {"type": "integer"},
    "structs": {"type": "array"},
    "tag": {"type": "boolean"}
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["name", "offset"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "offset": {"type": "integer", "minimum": 0},
        "type": {"type": "string"},
        "source": {"enum": ["game", "toolkit", "inferred", "extender", "unknown"]},
        "evidence": {"type": "string"},
        "legacy": {"type": "string"}
      }
    },
    "survey": {
      "type": "object",
      "additionalProperties": false,
      "description": "The keys of a layout other than component, kind, ext_name, oneFrame, size, summary and fields, as the survey wrote them; the batch folder it was written in; an empty summary.",
      "properties": {
        "batch": {"type": "string", "minLength": 1, "description": "The folder of layouts/ the layout was written in."},
        "summary": {"const": "", "description": "Only an empty summary stays here; one that says something is the type's `about`."},
        "base": {"type": "string"},
        "class_size": {"type": "integer"},
        "confidence": {"type": "string"},
        "creator": {"type": "string"},
        "evidence": {"type": "string"},
        "external_types": {"type": ["object", "array"]},
        "from": {"type": "string"},
        "functions_read": {"type": "integer"},
        "hold": {"type": "string"},
        "live": {"type": "string"},
        "live_reason": {"type": "string"},
        "minutes": {"type": "integer"},
        "names": {"type": "string"},
        "names_pass": {"type": "string"},
        "names_pass_2": {"type": "string"},
        "needs_windows": {"type": "string"},
        "object": {"type": "object", "additionalProperties": true},
        "one_byte": {"type": "string"},
        "one_byte_evidence": {"type": "string"},
        "one_byte_values": {"type": "object", "additionalProperties": true},
        "open_questions": {"type": "array", "items": {"type": "string"}},
        "raw_check": {"type": "string"},
        "reuses": {"type": "string"},
        "same_as": {"type": "string"},
        "se_pattern": {"type": "string"},
        "second_pass": {"type": "string"},
        "seen": {"type": "boolean"},
        "size_check": {"type": "string"},
        "status": {"enum": ["confirmed", "declared", "hypothesis"]},
        "status_reason": {"type": "string"},
        "storage_size": {"type": "integer"},
        "structs": {"type": "array"},
        "tag": {"type": "boolean"}
      }
    }
  }
}
